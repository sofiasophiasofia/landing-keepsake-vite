extends ../layouts/main

block title
  | #{ site.name } | Digital &amp; Branding Agency

//- append: додаємо description і Open Graph, не заміняючи charset/viewport з макета
block append meta
  include ../includes/meta

//- prepend: шрифти підключаються ДО основної таблиці стилів
block prepend styles
  include ../includes/fonts

block content
  include ../components/sections/hero
  include ../components/sections/works
  include ../components/sections/cta
  include ../components/sections/services
  include ../components/sections/stats
  include ../components/sections/journal
  include ../components/sections/clients

//- append scripts: мікророзмітка для пошуковиків (це не виконуваний JS)
block append scripts
  -
    const jsonLd = {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: site.name,
      email: site.email,
      telephone: site.phone,
    }
  script(type='application/ld+json')!= JSON.stringify(jsonLd)
