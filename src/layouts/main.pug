//- Базовий макет. Дані (змінна site) підключає сторінка в блоці data,
//- тому на початку макета вони вже доступні в head.
block data

doctype html
html(lang=site.lang)
  head
    block meta
      meta(charset='UTF-8')
      meta(name='viewport', content='width=device-width, initial-scale=1.0')
    block title
      title= site.title
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body#top
    include ../includes/sprite
    main
      block content
    block scripts
